# 로컬 MySQL 프로파일
SPRING_PROFILES_ACTIVE=local
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lionthanflower
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# dev PostgreSQL 프로파일
# SPRING_PROFILES_ACTIVE=dev
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>
# SPRING_DATASOURCE_USERNAME=<username>
# SPRING_DATASOURCE_PASSWORD=<password>

# 고객 서비스 진입 설정
ONBOARDING_STORE_CODE=MCM-SEOUL
CUSTOMER_SESSION_COOKIE_MAX_AGE=604800

# 웹 CORS 허용 Origin 설정
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://develop.mcm-orbit-n34.pages.dev,https://mcm-orbit-n34.pages.dev

# MCM Studio 프레임 합성 이미지 설정
MCM_STUDIO_FRAME_1_OVERLAY_URL=
MCM_STUDIO_FRAME_2_OVERLAY_URL=

# prod PostgreSQL 프로파일
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>
# SPRING_DATASOURCE_USERNAME=<username>
# SPRING_DATASOURCE_PASSWORD=<password>
